{
  "openapi": "3.1.0",
  "info": {
    "title": "NexusInsight API",
    "version": "0.1.0",
    "description": "Servicio local. Una organización por instancia. El frontend público funciona en modo demo autónomo."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "security": [
    {
      "BearerAuth": [],
      "Organization": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "Organization": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Organization-ID"
      }
    },
    "schemas": {
      "Operation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "organization_id",
          "title",
          "sector",
          "status",
          "amount_cents",
          "revision",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "sector": {
            "type": "string",
            "enum": [
              "logistics",
              "retail",
              "services"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "cancelled"
            ]
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Event": {
        "title": "OperationUpsertedV1",
        "description": "Snapshot completo. organization_id del sobre debe coincidir con data.organization_id. Solo una revisión mayor sustituye al registro anterior.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "type",
          "schema_version",
          "source",
          "organization_id",
          "occurred_at",
          "data"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "const": "operation.upserted.v1"
          },
          "schema_version": {
            "const": 1
          },
          "source": {
            "const": "nexuscore"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "organization_id",
              "title",
              "sector",
              "status",
              "amount_cents",
              "revision",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "organization_id": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string",
                "minLength": 3,
                "maxLength": 120
              },
              "sector": {
                "type": "string",
                "enum": [
                  "logistics",
                  "retail",
                  "services"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "in_progress",
                  "completed",
                  "cancelled"
                ]
              },
              "amount_cents": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Service liveness (not a database readiness guarantee)"
          }
        }
      }
    },
    "/v1/operations": {
      "get": {
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          {
            "name": "sector",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "logistics",
                "retail",
                "services"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "cancelled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Operation"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid key"
          },
          "403": {
            "description": "Organization rejected"
          },
          "409": {
            "description": "Revision/transition conflict"
          },
          "422": {
            "description": "Schema validation failed"
          }
        }
      }
    },
    "/v1/events": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted_events": {
                      "type": "integer"
                    },
                    "duplicate_events": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid key"
          },
          "403": {
            "description": "Organization rejected"
          },
          "409": {
            "description": "Revision/transition conflict"
          },
          "422": {
            "description": "Schema validation failed"
          }
        }
      }
    },
    "/v1/metrics": {
      "get": {
        "parameters": [
          {
            "name": "sector",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "logistics",
                "retail",
                "services"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "cancelled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "completed": {
                      "type": "integer"
                    },
                    "open": {
                      "type": "integer"
                    },
                    "completion": {
                      "type": "number"
                    },
                    "value_cents": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid key"
          },
          "403": {
            "description": "Organization rejected"
          },
          "409": {
            "description": "Revision/transition conflict"
          },
          "422": {
            "description": "Schema validation failed"
          }
        }
      }
    }
  }
}
