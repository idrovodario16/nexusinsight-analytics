# Desarrollo local: claves ficticias, no usar en producción.
POSTGRES_PASSWORD=local-fictional-database-password
API_KEY=local-fictional-insight-key-change-before-use
ORGANIZATION_ID=11111111-1111-4111-8111-111111111111
DATABASE_URL=postgresql+psycopg://nexus:local-fictional-database-password@localhost:5434/nexusinsight
WEB_ORIGIN=http://localhost:5174

# Optional: INTEGRATION_CREDENTIALS is a JSON registry of SHA-256 key digests.
# See docs/phase1-tenant-access.md and compose.integration.yaml.
# Do not set it to an empty string: explicit invalid configuration prevents startup.

# Modo restringido opcional: ver docs/phase2-database-isolation.md
# RUNTIME_DATABASE_URL debe usar un LOGIN dedicado; nunca la cuenta de migración.
# REQUIRE_DATABASE_ISOLATION=1 (para arranque fuera de Docker)
